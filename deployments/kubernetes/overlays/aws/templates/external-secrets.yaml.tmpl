apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: payment-platform-aws
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  provider:
    aws:
      service: SecretsManager
      region: ${AWS_REGION}
      auth:
        jwt:
          serviceAccountRef:
            name: external-secrets
            namespace: external-secrets
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: payment-database-secret
  namespace: payment-platform
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: 1m
  secretStoreRef:
    kind: ClusterSecretStore
    name: payment-platform-aws
  target:
    name: payment-database-secret
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      engineVersion: v2
      type: Opaque
      data:
        DATABASE_URL: 'postgres://{{ .DB_USERNAME }}:{{ .DB_PASSWORD | urlquery }}@${POSTGRES_ENDPOINT}:${POSTGRES_PORT}/${POSTGRES_DATABASE}?sslmode=require'
        DB_USERNAME: '{{ .DB_USERNAME }}'
        DB_PASSWORD: '{{ .DB_PASSWORD }}'
        DB_NAME: '${POSTGRES_DATABASE}'
  data:
    - secretKey: DB_USERNAME
      remoteRef:
        key: ${POSTGRES_SECRET_ARN}
        property: username
    - secretKey: DB_PASSWORD
      remoteRef:
        key: ${POSTGRES_SECRET_ARN}
        property: password
---
