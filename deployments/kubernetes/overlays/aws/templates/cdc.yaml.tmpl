apiVersion: v1
kind: ConfigMap
metadata:
  name: debezium-connector
  namespace: payment-platform
data:
  config.json: |
    {
      "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
      "tasks.max": "1",
      "database.hostname": "${POSTGRES_ENDPOINT}",
      "database.port": "${POSTGRES_PORT}",
      "database.user": "${DOLLAR}{directory:/opt/kafka/secrets:DB_USERNAME}",
      "database.password": "${DOLLAR}{directory:/opt/kafka/secrets:DB_PASSWORD}",
      "database.dbname": "${DOLLAR}{directory:/opt/kafka/secrets:DB_NAME}",
      "database.sslmode": "require",
      "topic.prefix": "payment-platform",
      "plugin.name": "pgoutput",
      "slot.name": "payment_outbox_slot",
      "publication.name": "payment_outbox_publication",
      "publication.autocreate.mode": "filtered",
      "table.include.list": "public.outbox_events",
      "snapshot.mode": "initial",
      "tombstones.on.delete": "false",
      "heartbeat.interval.ms": "10000",
      "key.converter": "org.apache.kafka.connect.storage.StringConverter",
      "value.converter": "org.apache.kafka.connect.json.JsonConverter",
      "value.converter.schemas.enable": "false",
      "transforms": "outbox",
      "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
      "transforms.outbox.table.field.event.id": "id",
      "transforms.outbox.table.field.event.key": "aggregate_id",
      "transforms.outbox.table.field.event.type": "event_type",
      "transforms.outbox.table.field.event.payload": "payload",
      "transforms.outbox.table.fields.additional.placement": "request_id:header:request_id",
      "transforms.outbox.table.expand.json.payload": "true",
      "transforms.outbox.route.by.field": "event_type",
      "transforms.outbox.route.topic.replacement": "${DOLLAR}{routedByValue}",
      "transforms.outbox.table.op.invalid.behavior": "warn"
    }
---
apiVersion: v1
kind: Service
metadata:
  name: debezium
  namespace: payment-platform
  labels:
    app.kubernetes.io/name: debezium
spec:
  selector:
    app.kubernetes.io/name: debezium
  ports:
    - {name: http, port: 8083, targetPort: http}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: debezium
  namespace: payment-platform
  annotations:
    secret.reloader.stakater.com/reload: payment-database-secret
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: debezium
  template:
    metadata:
      labels:
        app.kubernetes.io/name: debezium
        app.kubernetes.io/component: change-data-capture
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      securityContext:
        runAsNonRoot: true
        runAsUser: 1001
        runAsGroup: 1001
        fsGroup: 1001
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: wait-for-kafka-topics
          image: apache/kafka:3.9.1
          command: ["/bin/sh", "-ec"]
          args:
            - |
              printf '%s\n' 'security.protocol=SSL' > /tmp/client.properties
              until /opt/kafka/bin/kafka-topics.sh \
                --bootstrap-server '${KAFKA_BROKERS}' \
                --command-config /tmp/client.properties \
                --describe --topic payment.created.v1 >/dev/null 2>&1; do
                sleep 5
              done
          resources:
            requests: {cpu: 10m, memory: 96Mi}
            limits: {cpu: 250m, memory: 384Mi}
          volumeMounts:
            - {name: tmp, mountPath: /tmp}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
      containers:
        - name: debezium
          image: quay.io/debezium/connect:3.6.2.Final
          env:
            - {name: BOOTSTRAP_SERVERS, value: "${KAFKA_BROKERS}"}
            - {name: GROUP_ID, value: payment-platform-debezium-connect}
            - {name: CONFIG_STORAGE_TOPIC, value: payment.connect-configs}
            - {name: OFFSET_STORAGE_TOPIC, value: payment.connect-offsets}
            - {name: STATUS_STORAGE_TOPIC, value: payment.connect-status}
            - {name: CONFIG_STORAGE_REPLICATION_FACTOR, value: "${KAFKA_REPLICATION_FACTOR}"}
            - {name: OFFSET_STORAGE_REPLICATION_FACTOR, value: "${KAFKA_REPLICATION_FACTOR}"}
            - {name: STATUS_STORAGE_REPLICATION_FACTOR, value: "${KAFKA_REPLICATION_FACTOR}"}
            - {name: KEY_CONVERTER, value: org.apache.kafka.connect.json.JsonConverter}
            - {name: VALUE_CONVERTER, value: org.apache.kafka.connect.json.JsonConverter}
            - {name: KEY_CONVERTER_SCHEMAS_ENABLE, value: "false"}
            - {name: VALUE_CONVERTER_SCHEMAS_ENABLE, value: "false"}
            - {name: REST_ADVERTISED_HOST_NAME, value: debezium}
            - {name: OFFSET_FLUSH_INTERVAL_MS, value: "1000"}
            - {name: CONNECT_SECURITY_PROTOCOL, value: SSL}
            - {name: CONNECT_PRODUCER_SECURITY_PROTOCOL, value: SSL}
            - {name: CONNECT_CONSUMER_SECURITY_PROTOCOL, value: SSL}
            - {name: CONNECT_CONFIG_PROVIDERS, value: directory}
            - {name: CONNECT_CONFIG_PROVIDERS_DIRECTORY_CLASS, value: org.apache.kafka.common.config.provider.DirectoryConfigProvider}
            - {name: CONNECT_CONFIG_PROVIDERS_DIRECTORY_PARAM_ALLOWED_PATHS, value: /opt/kafka/secrets}
          ports:
            - {name: http, containerPort: 8083}
          startupProbe:
            httpGet: {path: /connectors, port: http}
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet: {path: /connectors, port: http}
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            httpGet: {path: /connectors, port: http}
            periodSeconds: 20
            timeoutSeconds: 5
          resources:
            requests: {cpu: 250m, memory: 768Mi}
            limits: {cpu: "1", memory: 1536Mi}
          volumeMounts:
            - name: database-credentials
              mountPath: /opt/kafka/secrets
              readOnly: true
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
      volumes:
        - name: database-credentials
          secret:
            secretName: payment-database-secret
            defaultMode: 0440
            items:
              - {key: DB_USERNAME, path: DB_USERNAME}
              - {key: DB_PASSWORD, path: DB_PASSWORD}
              - {key: DB_NAME, path: DB_NAME}
        - name: tmp
          emptyDir: {}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: debezium-connector-init
  namespace: payment-platform
  annotations:
    argocd.argoproj.io/hook: PostSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation,HookSucceeded
spec:
  backoffLimit: 20
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: debezium-connector-init
        app.kubernetes.io/component: change-data-capture
    spec:
      restartPolicy: OnFailure
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: wait-for-outbox-schema
          image: postgres:17-alpine
          command: ["/bin/sh", "-ec"]
          args:
            - |
              until [ "$(psql -tAc "SELECT to_regclass('public.outbox_events') IS NOT NULL")" = "t" ]; do
                sleep 5
              done
          env:
            - {name: PGHOST, value: "${POSTGRES_ENDPOINT}"}
            - {name: PGPORT, value: "${POSTGRES_PORT}"}
            - {name: PGSSLMODE, value: require}
            - name: PGDATABASE
              valueFrom: {secretKeyRef: {name: payment-database-secret, key: DB_NAME}}
            - name: PGUSER
              valueFrom: {secretKeyRef: {name: payment-database-secret, key: DB_USERNAME}}
            - name: PGPASSWORD
              valueFrom: {secretKeyRef: {name: payment-database-secret, key: DB_PASSWORD}}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {cpu: 100m, memory: 96Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
      containers:
        - name: configure
          image: curlimages/curl:8.16.0
          command: ["/bin/sh", "-ec"]
          args:
            - |
              until curl --fail --silent --show-error http://debezium:8083/connectors >/dev/null; do sleep 5; done
              curl --fail --silent --show-error \
                -X PUT \
                -H 'Content-Type: application/json' \
                --data-binary @/config/config.json \
                http://debezium:8083/connectors/payment-outbox/config

              attempt=0
              status=""
              while [ "${DOLLAR}attempt" -lt 120 ]; do
                status="$(curl --fail --silent http://debezium:8083/connectors/payment-outbox/status || true)"
                running="$(printf '%s' "${DOLLAR}status" | grep -Eo '"state"[[:space:]]*:[[:space:]]*"RUNNING"' | wc -l | tr -d ' ')"
                if [ "${DOLLAR}running" -ge 2 ]; then
                  exit 0
                fi
                attempt=$((attempt + 1))
                sleep 5
              done
              printf 'connector did not become ready: %s\n' "${DOLLAR}status" >&2
              exit 1
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {cpu: 100m, memory: 64Mi}
          volumeMounts:
            - {name: connector, mountPath: /config, readOnly: true}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
      volumes:
        - name: connector
          configMap:
            name: debezium-connector
