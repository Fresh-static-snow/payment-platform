apiVersion: v1
kind: ConfigMap
metadata:
  name: payment-platform-config
data:
  APP_ENV: aws
  REDIS_ADDR: ${REDIS_ENDPOINT}:${REDIS_PORT}
  REDIS_TLS_ENABLED: "true"
  KAFKA_BROKERS: ${KAFKA_BROKERS}
  KAFKA_TLS_ENABLED: "true"
  AWS_ENDPOINT: ""
  AWS_REGION: ${AWS_REGION}
  S3_BUCKET: ${S3_BUCKET}
  SNS_TOPIC_ARN: ${SNS_TOPIC_ARN}
  SQS_QUEUE_URL: ${SQS_QUEUE_URL}
  OTEL_EXPORTER_OTLP_ENDPOINT: ${OTEL_EXPORTER_OTLP_ENDPOINT}
  CORS_ALLOWED_ORIGIN: ${CORS_ALLOWED_ORIGIN}
  AUTH_DISABLED: "false"
  AUTH_ISSUER_URL: ${AUTH_ISSUER_URL}
  AUTH_JWKS_URL: ${AUTH_JWKS_URL}
  ELASTICSEARCH_URL: ${OPENSEARCH_ENDPOINT}
  ELASTICSEARCH_INDEX: payments-read-v1
  ELASTICSEARCH_ALIAS: payments-read
  CLICKHOUSE_URL: ${CLICKHOUSE_URL}
  CLICKHOUSE_USERNAME: ${CLICKHOUSE_USERNAME}
  TEMPORAL_ADDRESS: ${TEMPORAL_ADDRESS}
  TEMPORAL_NAMESPACE: default
